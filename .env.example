# =================================================================================================
# === CONFIGURATION ================================================================================
# =================================================================================================

# copy this file to .env, then edit the values below

# caddy will automatically request an ssl certificate for this domain
# DOC_DOMAIN=example.com


# let's encrypt requires an email for certificate expiration/renewal-failure notices
# SSL_EMAIL=webmaster@example.com

# host port caddy's http listener is published on, defaults to 3000
# must be set to 80 in production for let's encrypt
# HTTP_PORT=80

# host port the api container is published on directly, for local debugging
# left unset, it defaults to 3001 - e.g. curl http://127.0.0.1:3001/api/...
# the api is always reachable through caddy too, at $HTTP_PORT/api/*
# BACKEND_PORT=3001
