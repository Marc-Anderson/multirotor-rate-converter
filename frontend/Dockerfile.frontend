FROM caddy:2-alpine

# copy caddy config
COPY Caddyfile /etc/caddy/Caddyfile

# replace ${DOC_DOMAIN} with the DOC_DOMAIN environment variable
# RUN sed -i 's/\${DOC_DOMAIN}/'"$DOC_DOMAIN"'/g' /etc/caddy/Caddyfile

# copy application code
COPY ./ui/public /srv/public

EXPOSE 80 443

